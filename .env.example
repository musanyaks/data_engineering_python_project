# ============================================
# Data Engineering Pipeline - Environment Config
# Optimized for 16GB RAM / 100GB SSD
# ============================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_POOL_SIZE=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Pipeline
BATCH_SIZE=1000
MAX_RETRIES=3
RETRY_DELAY=1

# API
API_BASE_URL=https://api.example.com
API_TIMEOUT=30
API_KEY=your-api-key-here

# Environment
ENVIRONMENT=development

# ============================================
# Snowflake
# ============================================
SNOWFLAKE_ACCOUNT=your-account.region
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=DBT_DEV
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ============================================
# Spark - Tuned for 16GB RAM
# ============================================
# Driver: 4GB (manages job, collects small results)
# Executor: 4GB (processes data in parallel)
# Total: ~10GB for Spark, leaving 6GB for OS + other services
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=4
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DEFAULT_PARALLELISM=8

# ============================================
# Airflow
# ============================================
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
